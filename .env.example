# LandTrax Document Library Microservice Environment Variables
# ====================================================
PORT=5022
TCP_PORT=5023
APP_VERSION=1.0.0
NODE_ENV=development

# Database Configuration (Shared SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassw0rd123
DB_NAME=landtrax
ENABLE_QUERY_LOGGING=false

# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=document-lib-microservice
KAFKA_GROUP_ID=document-lib-consumer

# Redis / BullMQ Configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CLUSTER=false

# Security & Gateway Secret
GATEWAY_SECRET=development_gateway_secret_key_landtrax_2026
APP_AUTH=internal_shared_secret

# AWS S3 Storage
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=landtrax-documents
CLOUD_STORAGE_PROVIDER=AWS_S3
JWT_REFRESH_EXPIRATION_TIME=86400
